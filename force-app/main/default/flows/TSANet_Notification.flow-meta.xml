<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Mark_Note_Notified</name>
        <description>Sets isNotified__c through Apex because an after-save flow must not update its own record.</description>
        <label>Mark Note Notified</label>
        <locationX>656</locationX>
        <locationY>646</locationY>
        <actionName>TSANetInvocableMarkNotesNotified</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>noteIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>TSANetInvocableMarkNotesNotified</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Template record-triggered flow that sends notifications to case owners for new TSANet notes. Triggers on Create and Update so notes synced via refresh/webhook upsert (which resolves to UPDATE for existing rows) are still notified; the isNotified__c entry condition guarantees once-only delivery. Notes created before today are stamped isNotified__c = true by the TSANetNote trigger (TSANetNoteTriggerHelper.markStaleNotesAsNotified), so a full sync after connecting credentials does not notify for historical notes. The flag is set through the TSANet Mark Notes Notified Apex action because an after-save flow must not update its own triggering record. Subscribers can deactivate or clone this template to customize.</description>
    <environments>Default</environments>
    <formulas>
        <name>Body</name>
        <dataType>String</dataType>
        <expression>&apos;You got a new note - &apos; + {!$Record.tsanetconnect__Summary__c} + &apos;. &apos; +
{!$Record.tsanetconnect__DescriptionPlainText__c}</expression>
    </formulas>
    <interviewLabel>TSANet Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <isTemplate>true</isTemplate>
    <label>TSANet: Inbound: Note Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetTSANetCase</name>
        <label>Get TSANet Case</label>
        <locationX>656</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SendNotification</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.TSANetCase__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TSANetCase__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>530</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>GetTSANetCase</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>isNotified__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>TSANetNote__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SendNotification</name>
        <label>Send Notification</label>
        <locationX>656</locationX>
        <locationY>510</locationY>
        <connector>
            <targetReference>Mark_Note_Notified</targetReference>
        </connector>
        <flowName>TSANetNotification</flowName>
        <inputAssignments>
            <name>body</name>
            <value>
                <elementReference>Body</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TargetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TSANetCase</name>
            <value>
                <elementReference>GetTSANetCase</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <triggerOrder>40</triggerOrder>
</Flow>
